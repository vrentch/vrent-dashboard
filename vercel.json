{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [{ "source": "/clearhead", "destination": "/clearhead/", "permanent": false }],
  "rewrites": [{ "source": "/((?!api/).*)", "destination": "/index.html" }]
}
